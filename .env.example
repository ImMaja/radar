# Copy these settings to .env.local. The database credentials below are only
# for the local container and must never be reused in production.
RADAR_ENVIRONMENT=development
RADAR_DATABASE_URL=postgresql+psycopg://radar:radar-local-only@127.0.0.1:5432/radar
RADAR_TEST_DATABASE_URL=postgresql+psycopg://radar:radar-local-only@127.0.0.1:5432/radar_test
RADAR_PUBLIC_ORIGIN=http://127.0.0.1:8000
RADAR_FRONTEND_DIRECTORY=frontend/dist
RADAR_SESSION_IDLE_SECONDS=43200
RADAR_SESSION_ABSOLUTE_SECONDS=604800
RADAR_SIRENE_API_KEY=
RADAR_DATATOURISME_API_KEY=
