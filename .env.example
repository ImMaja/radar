# Copy these settings to .env.local. The database credentials below are only
# for the local container and must never be reused in production.
RADAR_ENVIRONMENT=development
RADAR_DATABASE_URL=postgresql+psycopg://radar:radar-local-only@127.0.0.1:5432/radar
RADAR_TEST_DATABASE_URL=postgresql+psycopg://radar:radar-local-only@127.0.0.1:5432/radar_test
RADAR_PUBLIC_ORIGIN=http://127.0.0.1:8000
RADAR_FRONTEND_DIRECTORY=frontend/dist
RADAR_SESSION_IDLE_SECONDS=43200
RADAR_SESSION_ABSOLUTE_SECONDS=604800
RADAR_SIRENE_API_KEY=
# The Sirene connector remains disabled until all four required values below
# point to one manually downloaded official monthly Parquet release.
# RADAR_SIRENE_GEOLOCATION_FILE=/srv/radar/data/StockEtablissement_utf8.parquet
# RADAR_SIRENE_GEOLOCATION_RESOURCE_IDENTIFIER=2026-09
# RADAR_SIRENE_GEOLOCATION_RESOURCE_URL=https://www.data.gouv.fr/fr/datasets/r/...
# RADAR_SIRENE_GEOLOCATION_RETRIEVED_AT=2026-09-24T12:00:00+02:00
# Optional integrity and publication metadata:
# RADAR_SIRENE_GEOLOCATION_PUBLISHED_ON=2026-09-01
# RADAR_SIRENE_GEOLOCATION_EXPECTED_SHA1=0000000000000000000000000000000000000000
# RADAR_SIRENE_GEOLOCATION_EXPECTED_SIZE_BYTES=1
# RADAR_SIRENE_GEOLOCATION_LICENSE_NAME=Licence Ouverte 2.0
RADAR_DATATOURISME_API_KEY=
